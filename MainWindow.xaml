                </StackPanel>
              </Border>
              <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="STREAK" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Name="ProfileStreakTextBlock" Text="0 day streak" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                  <TextBlock Text="LEARNING" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Name="ProfileLearningTextBlock" Text="No learned corrections yet" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
        <Grid Name="DictionaryPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource PremiumPanel}" Padding="22" Margin="0,0,14,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="DICTIONARY" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Words Speak should remember" FontFamily="{StaticResource DisplayFontFamily}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <TextBlock Name="DictionaryCountTextBlock" Text="0 terms" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold" />
                  </Border>
                  <Button Style="{StaticResource ResourceKey=PrimaryButton}" Click="AddVocabularyButton_Click">Add Word</Button>
                </StackPanel>
              </Grid>
              <StackPanel Name="DictionaryTabsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="{DynamicResource InkBrush}" CornerRadius="1" Width="22" Height="2" VerticalAlignment="Bottom" Margin="0,0,10,4" />
                <TextBlock Text="All" Foreground="{DynamicResource InkBrush}" FontWeight="Bold" Margin="0,0,22,0" />
                <TextBlock Text="Automatic" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,22,0" />
                <TextBlock Text="Manual" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" />
              </StackPanel>
              <Border Name="DictionaryHeroPanel" Grid.Row="2" Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Speak writes it the way you do." FontFamily="{StaticResource DisplayFontFamily}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="Save names, product terms, shortcuts, and corrections. Automatic learning can update this list after you fix pasted text." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="650" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                      <TextBlock Text="GitHub" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                      <TextBlock Text="Wispr Flow" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <DataGrid Name="VocabularyGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Spoken" Width="*" Binding="{Binding Spoken}" />
                  <DataGridTextColumn Header="Written" Width="*" Binding="{Binding Written}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource PremiumPanel}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
              <StackPanel>
                <TextBlock Text="CORRECTION" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Correction Flow" FontFamily="{StaticResource DisplayFontFamily}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="Teach a phrase once. Speak applies it before polishing and after LLM cleanup." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18" />
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="AUTO-ADD" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                      <TextBlock Text="Learn corrections after I fix pasted text" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                      <TextBlock Text="When you correct a pasted word, Speak remembers that spelling for future dictation." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                    <CheckBox Name="DictionaryAutoLearnCheckBox" Grid.Column="1" VerticalAlignment="Top" Margin="14,2,0,0" ToolTip="Automatically add corrected words to the dictionary" Checked="DictionaryAutoLearnCheckBox_Changed" Unchecked="DictionaryAutoLearnCheckBox_Changed" />
                  </Grid>
                </Border>
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="HEARD" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBox Name="CorrectionSpokenTextBox" MinHeight="44" Margin="0,8,0,14" />
                    <TextBlock Text="PREFERRED" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBox Name="CorrectionWrittenTextBox" MinHeight="44" Margin="0,8,0,0" />
                    <Button Margin="0,18,0,8" Style="{StaticResource ResourceKey=PrimaryButton}" Click="TeachCorrectionButton_Click">Save Correction</Button>
                    <Button Style="{StaticResource ResourceKey=RoundedButton}" Click="UseSelectionForCorrectionButton_Click">Load Selection</Button>
                  </StackPanel>
                </Border>
                <Button Margin="0,0,0,10" Style="{StaticResource ResourceKey=RoundedButton}" Click="SaveVocabularyButton_Click">Save Dictionary</Button>
                <Button Style="{StaticResource ResourceKey=RoundedButton}" Click="ResetVocabularyButton_Click">Reset Defaults</Button>
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="LEARNED TODAY" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Name="LearnedCorrectionsSummaryTextBlock" Text="No auto-learned corrections waiting." Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,10" />
                    <ListBox Name="LearnedCorrectionsListBox" MaxHeight="128" Margin="0,0,0,10" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                              <TextBlock Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ReviewTitle}" />
                              <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" Text="{Binding ReviewSubtitle}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ListBox>
                    <UniformGrid Columns="2">
                      <Button Margin="0,0,6,0" Style="{StaticResource ResourceKey=ActionButton}" Click="ApproveLearnedCorrectionButton_Click">Approve</Button>
                      <Button Margin="6,0,0,0" Style="{StaticResource ResourceKey=ActionButton}" Click="UndoLearnedCorrectionButton_Click">Undo</Button>
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,22,0,18" />
                <StackPanel>
                  <TextBlock Text="FORMAT" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="spoken phrase" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                  <TextBlock Text="preferred written form" Foreground="{DynamicResource InkBrush}" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Grid Name="SettingsPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource PremiumPanel}" Padding="22" Margin="0,0,18,0">
            <ScrollViewer Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
              <StackPanel>
                <TextBlock Text="RUNTIME SETTINGS" Foreground="{DynamicResource GoldBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Local engine" FontFamily="{StaticResource DisplayFontFamily}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,20" />
                <TextBlock Text="Language" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="LocaleComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Engine" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="EngineComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Transcription model" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="TranscriptionModelComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Cloud STT provider" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="CloudSttProviderComboBox" Margin="0,8,0,12" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Name="CloudSttStatusTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14" />
                <TextBlock Text="Cloud STT model" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="CloudSttModelComboBox" IsEditable="True" IsTextSearchEnabled="True" MinHeight="38" Margin="0,8,0,12" SelectionChanged="SettingsControl_Changed" LostFocus="SettingsControl_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Margin="0,0,10,0" Style="{StaticResource ResourceKey=RoundedButton}" Click="RefreshCloudSttModelsButton_Click">Refresh STT Models</Button>
                  <Button Style="{StaticResource ResourceKey=RoundedButton}" Click="TestCloudSttProviderButton_Click">Test STT Provider</Button>
                </StackPanel>
                <TextBlock Text="Cloud STT endpoint" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBox Name="CloudSttEndpointTextBox" MinHeight="38" Margin="0,8,0,12" TextChanged="SettingsControl_Changed" />
                <TextBlock Text="Cloud STT API key env var" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBox Name="CloudSttApiKeyEnvTextBox" MinHeight="38" Margin="0,8,0,16" TextChanged="SettingsControl_Changed" />
                <TextBlock Text="Processing device" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="WhisperDeviceComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Model offload timer" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="ModelKeepAliveComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Microphone" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="AudioInputComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="After transcription" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="OutputDestinationComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="LLM polish" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="LlmPolishProviderComboBox" Margin="0,8,0,12" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Name="LlmPolishStatusTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14" />
                <TextBlock Text="Polish model" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="LlmPolishModelComboBox" IsEditable="True" IsTextSearchEnabled="True" MinHeight="38" Margin="0,8,0,12" SelectionChanged="SettingsControl_Changed" LostFocus="SettingsControl_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Margin="0,0,10,0" Style="{StaticResource ResourceKey=RoundedButton}" Click="RefreshPolishModelsButton_Click">Refresh Models</Button>
                  <Button Style="{StaticResource ResourceKey=RoundedButton}" Click="TestPolishProviderButton_Click">Test Provider</Button>
                </StackPanel>
                <TextBlock Text="Polish endpoint" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBox Name="LlmPolishEndpointTextBox" MinHeight="38" Margin="0,8,0,12" TextChanged="SettingsControl_Changed" />
                <TextBlock Text="API key env var" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBox Name="LlmPolishApiKeyEnvTextBox" MinHeight="38" Margin="0,8,0,12" TextChanged="SettingsControl_Changed" />
                <TextBlock Text="Polish timeout" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="LlmPolishTimeoutComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Recording cleanup" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="RecordingRetentionComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <ComboBox Name="ThemeComboBox" Margin="0,8,0,16" SelectionChanged="SettingsControl_Changed" />
                <CheckBox Name="KeepHistoryCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Keep local history</CheckBox>
                <CheckBox Name="ShowCompletionToastCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Show copied/pasted toast</CheckBox>
                <CheckBox Name="AutoLearnCorrectionsCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Auto-learn corrections</CheckBox>
                <TextBlock Text="Dictation shortcut" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                  <Button Name="ShortcutCaptureButton" MinWidth="160" Margin="0,0,10,0" Style="{StaticResource ResourceKey=RoundedButton}" Click="ShortcutCaptureButton_Click">Ctrl + Win</Button>
                  <Button Style="{StaticResource ResourceKey=RoundedButton}" Click="ResetShortcutButton_Click">Reset</Button>
                </StackPanel>
                <TextBlock Name="ShortcutStatusTextBlock" Text="Press this shortcut anywhere to start or stop recording." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16" />
                <CheckBox Name="ShowWidgetCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Show floating dictation widget</CheckBox>
                <CheckBox Name="MinimizeToTrayCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Minimize to tray</CheckBox>
                <CheckBox Name="StartWithWindowsCheckBox" Margin="0,0,0,22" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed">Start Speak with Windows</CheckBox>
                <Button Style="{StaticResource ResourceKey=PrimaryButton}" Click="SaveSettingsButton_Click">Save Settings</Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource PremiumPanel}" Padding="22">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="LOCAL MODEL" Foreground="{DynamicResource GoldBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="Whisper runtime" FontFamily="{StaticResource DisplayFontFamily}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Model path" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Name="WhisperModelPathTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="Runtime" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Name="WhisperWrapperPathTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    <TextBlock Name="WhisperRuntimeStatusTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="LLM polish" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Name="LlmPolishRuntimeTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
                <Button Name="StopLoadedModelButton" Margin="0,20,0,0" Style="{StaticResource ResourceKey=RoundedButton}" Click="StopLoadedModelButton_Click">Stop Loaded Model</Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
