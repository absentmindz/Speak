{
  "Paths": {
    "ToolsRoot": "{AppDir}",
    "ModelsRoot": "",
    "WorkspaceRoot": "",
    "CacheRoot": "{LocalAppData}\\Speak\\cache"
  },
  "Transcription": {
    "DefaultEngine": "whisper-local",
    "DefaultModel": "whisper-large-v3",
    "DefaultDevice": "cuda",
    "ModelKeepAliveMinutes": 10,
    "WhisperPythonPath": "",
    "WhisperWrapperPath": "{AppDir}\\Tools\\speak_worker.py",
    "WhisperModelPath": "{ModelsRoot}\\whisper\\large-v3.pt",
    "WhisperServerScriptPath": "{AppDir}\\Tools\\whisper_resident_server.py"
  },
  "TTS": {
    "DefaultEngine": "qwen3-customvoice-1.7b",
    "DefaultVoice": "Aiden",
    "DefaultLanguage": "English",
    "OutputRoot": "",
    "ChatterboxPythonPath": "",
    "ComfyUIPythonPath": "",
    "TortoisePythonPath": "",
    "QwenTtsCustomVoiceModelPath": "{ModelsRoot}\\Qwen3-TTS-12Hz-1.7B-CustomVoice",
    "QwenTtsBaseModelPath": "{ModelsRoot}\\Qwen3-TTS-12Hz-1.7B-Base",
    "QwenTtsVoiceDesignModelPath": "",
    "TortoiseModelDir": ""
  },
  "CloudSTT": {
    "DefaultProvider": "groq",
    "DefaultEndpoint": "https://api.groq.com/openai/v1",
    "DefaultModel": "whisper-large-v3-turbo",
    "DefaultApiKeyEnvVar": "GROQ_API_KEY"
  },
  "LLMPolish": {
    "DefaultProvider": "off",
    "DefaultEndpoint": "",
    "DefaultModel": "",
    "DefaultApiKeyEnvVar": "",
    "DefaultTimeoutSeconds": 12
  },
  "Recording": {
    "RetentionDays": 30
  },
  "UI": {
    "Theme": "dark",
    "KeepHistory": true,
    "ShowCompletionToast": true,
    "AutoLearnCorrections": false,
    "ShowShortcutWidget": true,
    "MinimizeToTray": true,
    "StartWithWindows": false,
    "DictationShortcut": "Ctrl+Win"
  },
  "Commercial": {
    "WebsiteUrl": "https://absentmindz.github.io/Speak/",
    "PricingUrl": "https://absentmindz.github.io/Speak/#pricing",
    "CheckoutUrl": "https://absentmindz.github.io/Speak/#founding",
    "SupportUrl": "https://github.com/absentmindz/Speak/issues",
    "LicensePortalUrl": ""
  },
  "Logging": {
    "Level": "Information",
    "File": "logs/speak-.log"
  }
}
